# AI 单词游戏 - 虚拟主机配置（兼容 Apache 2.2 / 2.4）

# 默认首页（廉价主机只认 index.php）
DirectoryIndex index.php index.html check.php

# 关键：将 Authorization 头传递给 PHP（廉价主机会剥离此头）
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# 禁止列出目录（用 IfModule 包裹，避免 AllowOverride 限制导致 403）
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# 保护数据文件不被直接下载（兼容 2.2 / 2.4）
<FilesMatch "\.(json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
